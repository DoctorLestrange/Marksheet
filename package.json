{
  "name": "marksheet",
  "private": true,
  "version": "1.0.0",
  "description": "An accurate, client-side exam score calculator with question-by-question mark records, negative marking, session history, and persistent localStorage storage.",
  "license": "MIT",
  "keywords": [
    "exam-calculator",
    "score-calculator",
    "negative-marking",
    "omr",
    "react",
    "typescript",
    "tailwindcss",
    "localstorage"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/scoring.test.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
